{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "horizon-live-api",
  "main": "src/index-v6.js",
  "compatibility_date": "2026-08-22",
  "workers_dev": true,
  "keep_vars": true,
  "cache": {
    "enabled": true
  },
  "ratelimits": [
    {
      "name": "EMAIL_PDF_RATE_LIMIT",
      "namespace_id": "2202605",
      "simple": {"limit": 3, "period": 60}
    }
  ],
  "secrets": {
    "required": ["SERPAPI_API_KEY"]
  },
  "vars": {
    "AMADEUS_ENV": "test",
    "ALLOWED_ORIGIN": "https://civilengineergreece.github.io"
  }
}
